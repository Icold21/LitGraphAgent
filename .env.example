# ==============================================================================
# Universal LLM Configuration (DeepSeek / OpenAI / Groq / Local)
# ==============================================================================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ==============================================================================
# Academic Search & Graph Limits
# ==============================================================================
SEMANTIC_SCHOLAR_API_KEY=
DEFAULT_VAULTS_DIR=./vaults

MAX_PAPERS_PER_RUN=8
MIN_PAPERS_PER_RUN=3
MAX_SEARCH_CANDIDATES=25
CITATION_EXPANSION_LIMIT=3
ENABLE_ELBOW_CUTOFF=true